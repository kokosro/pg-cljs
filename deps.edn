{:paths ["src"]
 ;; `pg` (node-postgres) is provided through package.json (npm), not deps.edn:
 ;; tools.deps has no npm coordinate type, so package.json is the npm source
 ;; of truth and node resolves `pg` at runtime from the consumer's node_modules.
 :deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
        org.clojure/core.async {:mvn/version "1.6.681"}
        funcool/promesa {:mvn/version "12.0.1"}}
 :aliases
 {;; Development: shadow-cljs compiler + core.async + promesa. Use via
  ;; `clojure -M:dev -m shadow.cljs.devtools.cli watch dev`. NOTE: shadow-cljs.edn is
  ;; standalone (no :deps) and declares the same dependencies itself for `npx shadow-cljs ...`.
  :dev {:extra-paths ["test" "dev"]
        :extra-deps {thheller/shadow-cljs {:mvn/version "2.28.23"}}}
  ;; Tests: same toolchain plus the test source path.
  :test {:extra-paths ["test"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "2.28.23"}}}}}
